+++ b/src/main/java/com/acme/reservations/service/LockingStrategy.java	2026-11-23 06:42:18
@@ -0,0 +1,40 @@
+package com.acme.reservations.service;
+
+import com.acme.reservations.db.Transaction;
+import com.acme.reservations.domain.*;
+
+import java.util.Optional;
+
+/**
+ * Concurrency control for the create-reservation critical section. Selected per deployment with
+ * {@code reservation.locking.strategy} in {@code config/reservation.properties}.
+ *
+ * <p>Every implementation must keep its locks in the shared database (never in the JVM), because
+ * production runs several pods. Every lock wait is bounded by the DB {@code lock_timeout} (50ms);
+ * a timeout surfaces as {@link com.acme.reservations.db.LockWaitTimeoutException} and is handled by
+ * {@link RetryPolicy}.
+ */
+public interface LockingStrategy {
+
+    /** Value of {@code reservation.locking.strategy} that selects this implementation. */
+    String name();
+
+    /**
+     * Takes this strategy's locks for {@code interval} on {@code resourceId} inside {@code tx}.
+     * Locks are held until the transaction commits or rolls back.
+     */
+    Lease acquire(Transaction tx, String resourceId, TimeInterval interval);
+
+    /** Cancel path: undo whatever {@link Lease#claim} recorded for {@code reservation}. */
+    void release(Transaction tx, Reservation reservation);
+
+    /** What the acquired locks protect, for the rest of the transaction. */
+    interface Lease {
+
+        /** Id of a confirmed reservation that overlaps the requested interval, as seen under the locks. */
+        Optional<String> clash();
+
+        /** Called right after the reservation row is inserted, still inside the transaction. */
+        void claim(Transaction tx, String reservationId);
+    }
+}
diff -ruN -x build -x reports a/src/main/java/com/acme/reservations/service/PessimisticResourceLock.java b/src/main/java/com/acme/reservations/service/PessimisticResourceLock.java
--- a/src/main/java/com/acme/reservations/service/PessimisticResourceLock.java	1970-01-01 05:30:00
+++ b/src/main/java/com/acme/reservations/service/PessimisticResourceLock.java	2026-11-23 06:42:26
@@ -0,0 +1,59 @@
+package com.acme.reservations.service;
+
+import com.acme.reservations.db.Transaction;
+import com.acme.reservations.domain.*;
+import com.acme.reservations.persistence.ResourceRepository;
+
+import java.util.Optional;
+
+/**
+ * Candidate 1 - pessimistic, resource-scoped locking.
+ * <pre>
+ *   SELECT * FROM resource WHERE id = :resourceId FOR UPDATE;   -- waits at most lock_timeout (50ms)
+ *   -- re-check overlap on reservation (READ COMMITTED sees the previous holder's commit)
+ *   INSERT INTO reservation ...; COMMIT;                        -- COMMIT releases the row lock
+ * </pre>
+ * <ul>
+ *   <li>Multi-node: the lock is a row lock in the shared database, so it works across pods.</li>
+ *   <li>Non-existent rows: the parent resource row always exists, so there is always something to lock,
+ *       even when the competing reservation has not been written yet.</li>
+ *   <li>Cost: EVERY booking of the resource queues on one row, including bookings for unrelated times.</li>
+ * </ul>
+ */
+public final class PessimisticResourceLock implements LockingStrategy {
+
+    private final ResourceRepository resources;
+    private final SlotAvailabilityChecker availability;
+
+    public PessimisticResourceLock(ResourceRepository resources, SlotAvailabilityChecker availability) {
+        this.resources = resources;
+        this.availability = availability;
+    }
+
+    @Override
+    public String name() {
+        return "pessimistic";
+    }
+
+    @Override
+    public Lease acquire(Transaction tx, String resourceId, TimeInterval interval) {
+        resources.lockById(tx, resourceId);
+        Optional<String> clash = availability.findConflict(tx, resourceId, interval).map(Reservation::id);
+        return new Lease() {
+            @Override
+            public Optional<String> clash() {
+                return clash;
+            }
+
+            @Override
+            public void claim(Transaction tx, String reservationId) {
+                // Nothing to record: the inserted reservation row is what the next lock holder re-checks.
+            }
+        };
+    }
+
+    @Override
+    public void release(Transaction tx, Reservation reservation) {
+        // Nothing to undo: the row lock is released by COMMIT, and the cancelled row stops matching findConflict.
+    }
+}
